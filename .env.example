# Server Port
PORT=5000

# Client Origin (CORS and WebRTC Target for Backend)
# Production: https://niji-samvad.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Frontend Vite Backend API URL (Baked into production client build on Vercel)
# Production: https://nijisamvad-backend.onrender.com
VITE_API_URL=https://nijisamvad-backend.onrender.com

# Node Environment
# Set to 'production' in production to enforce strict CSP, HSTS, and security defaults
NODE_ENV=development


# Optional overrides if attachment cleanup needs tuning (in hours)
# ATTACHMENT_TTL=24
