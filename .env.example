# Server Port
PORT=5000

# Client Origin (CORS and WebRTC Target)
# Local: http://localhost:5173
# Production: https://your-production-url.com
CLIENT_ORIGIN=http://localhost:5173

# Node Environment
# Set to 'production' in production to enforce strict CSP, HSTS, and other security defaults
NODE_ENV=development

# Optional overrides if attachment cleanup needs tuning (in hours)
# ATTACHMENT_TTL=24
